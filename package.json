{
  "name": "@vllnt/convex-helpers",
  "version": "0.1.0",
  "description": "Typed Convex host-side utilities, trusted-origin and cookie configuration helpers, identity-row glue, and optional MCP tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "docs",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "default": "./dist/better-auth.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tests/tsconfig.json",
    "typecheck:ci": "tsc --noEmit --project tsconfig.ci.json && tsc --noEmit --project tests/tsconfig.json",
    "lint": "pnpm check:agents && pnpm check:docs && eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "generate:llms": "node scripts/generate-llms.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm typecheck && pnpm generate:llms",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\""
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.45.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/eslint-config": "2.0.0",
    "@vllnt/typescript": "2.0.0",
    "convex": "^1.48.0",
    "convex-test": "^0.0.65",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "overrides": {
      "@hono/node-server@<2.1.3": "2.1.3",
      "body-parser@<2.4.0": "2.4.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5 <5.0.12": "5.0.12",
      "fast-uri@<3.1.9": "3.1.9",
      "handlebars@<4.7.10": "4.7.10",
      "hono@<4.13.11": "4.13.11",
      "ip-address@<10.7.4": "10.7.4",
      "magic-string": "1.4.3",
      "postcss": "8.5.31",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.1": "6.16.1",
      "rolldown": "1.2.15",
      "source-map-js@<1.2.2": "1.2.2",
      "vite>esbuild": "0.28.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/vllnt/convex-helpers#readme",
  "bugs": {
    "url": "https://github.com/vllnt/convex-helpers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-helpers"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "keywords": [
    "convex",
    "convex-helpers",
    "typescript",
    "backend",
    "utils",
    "mcp",
    "model-context-protocol"
  ]
}
