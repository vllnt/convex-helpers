{
  "name": "@vllnt/convex-helpers",
  "version": "0.2.1",
  "description": "TypeScript helpers for Convex backends: custom function builders, runtime validators, auth identity rows, Better Auth origins and an MCP tool server.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "files": [
    "dist",
    "src",
    "docs/API.md",
    "CHANGELOG.md",
    "NOTICE",
    "llms.txt",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "default": "./dist/better-auth.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "default": "./dist/builders.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "default": "./dist/validators.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo && tsc --noEmit --project tests/tsconfig.json",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo --project tsconfig.ci.json && tsc --noEmit --project tests/tsconfig.json",
    "lint": "pnpm check:agents && pnpm check:docs && pnpm check:package && eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:package": "bash scripts/test-package.sh",
    "generate:llms": "node scripts/generate-llms.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm typecheck && pnpm generate:llms",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\""
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.45.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "2.1.0",
    "@vllnt/typescript": "3.0.0",
    "convex": "^1.51.0",
    "convex-helpers": "0.1.136",
    "convex-test": "^0.0.73",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.9",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "handlebars@<4.7.10": "4.7.10"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://oss.vllnt.com/packages/convex-helpers",
  "bugs": {
    "url": "https://github.com/vllnt/convex-helpers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-helpers"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "keywords": [
    "convex",
    "convex-helpers",
    "typescript",
    "backend",
    "custom-functions",
    "validators",
    "identity",
    "better-auth",
    "mcp",
    "model-context-protocol"
  ]
}
