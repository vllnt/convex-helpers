{
  "name": "@vllnt/convex-helpers",
  "version": "0.1.0",
  "description": "Typed host-side helpers for Convex backends — builders, errors, validators, relationships, pagination, HTTP, env, and observability.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "typecheck:ci": "tsc --noEmit --project tsconfig.ci.json && tsc --noEmit --project tsconfig.test.json",
    "lint": "pnpm check:agents && eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "generate:llms": "node scripts/generate-llms.mjs",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm typecheck && pnpm generate:llms",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\""
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.45.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vllnt/eslint-config": "2.0.0",
    "@vllnt/typescript": "2.0.0",
    "convex": "^1.45.0",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/vllnt/convex-helpers#readme",
  "bugs": {
    "url": "https://github.com/vllnt/convex-helpers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-helpers"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "keywords": [
    "convex",
    "convex-helpers",
    "typescript",
    "backend",
    "utils",
    "mcp",
    "model-context-protocol"
  ]
}
