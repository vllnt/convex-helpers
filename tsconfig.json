{
  "extends": "@vllnt/typescript/node-library.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    // Off until adopted on its own: enabling it changes the public `.d.ts` and
    // runtime object shapes (e.g. `query()` returning keys set to undefined).
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
