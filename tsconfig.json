{
  "extends": "@vllnt/typescript/node-library.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    // Off until adopted on its own: enabling it fails the type-check in src/mcp,
    // and each fix either widens public optional props to `T | undefined` in the
    // `.d.ts` or drops undefined-valued keys from runtime objects (e.g. the
    // `ToolDef` that `query()` returns).
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
